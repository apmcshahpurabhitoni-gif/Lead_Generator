# Telegram / webhook
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=https://YOUR-SERVICE.onrender.com

# Canonical Supabase database
SUPABASE_URL=
SUPABASE_KEY=

# Dashboard authentication / URL
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-this
DASHBOARD_URL=https://YOUR-SERVICE.onrender.com/dashboard

# LeadHunter Research Worker v0.5.1
# These are REQUIRED by the main LeadHunter service.
RESEARCH_WORKER_URL=https://leadhunter-research-worker.onrender.com
WORKER_API_KEY=
RESEARCH_WORKER_PATH=/serp
RESEARCH_WORKER_TIMEOUT=90
RESEARCH_WORKER_MAX_RESULTS=10

# Optional AI provider
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_MODEL=gemma4

# Optional Google Maps / Places enrichment
GOOGLE_MAPS_API_KEY=
